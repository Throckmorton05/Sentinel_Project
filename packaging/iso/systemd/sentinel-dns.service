[Unit]
Description=Sentinel protected local AdGuard Home resolver
ConditionPathExists=/etc/sentinel/iso-installed.json
Requires=sentinel-dns-firewall.service
After=sentinel-dns-firewall.service local-fs.target
Before=sentinel-first-boot.service

[Service]
Type=simple
User=sentinel-dns
Group=sentinel-dns
ExecStart=/opt/AdGuardHome/AdGuardHome -c /etc/sentinel/adguard-home/AdGuardHome.yaml -w /var/lib/sentinel/adguard --no-check-update
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/sentinel/adguard-home /var/lib/sentinel/adguard
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
