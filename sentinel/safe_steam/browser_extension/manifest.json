{
  "manifest_version": 3,
  "name": "Sentinel Safe Steam",
  "version": "0.3.0",
  "description": "Enforces daemon-approved Sentinel Steam Store restrictions.",
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
